# ══════════════════════════════════════════════════════════
#  NutriOS — Environment Variables
#  cp .env.example .env  then fill in every value below.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Telegram ────────────────────────────────────────────────
# Get from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Webhook base URL (your Railway/VPS domain, no trailing slash)
# Leave empty to use long-polling instead
WEBHOOK_BASE_URL=https://your-api.railway.app

# How long Telegram initData stays valid (seconds). Default = 24 h.
TELEGRAM_DATA_MAX_AGE=86400

# ── Google Gemini AI ─────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_from_google_ai_studio
GEMINI_MODEL=gemini-1.5-flash

# ── Database ─────────────────────────────────────────────────
# Railway sets this automatically when you attach a Postgres plugin.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calorietracker

# ── Auth / JWT ────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_random_64_char_string

# ── CORS / Frontend ───────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://web.telegram.org,https://k.web.telegram.org,https://your-app.vercel.app
